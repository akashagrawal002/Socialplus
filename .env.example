# ============================================================
# SocialPulse AI — Environment Variables
# Copy this to .env and fill in values
# ============================================================

# ---- SERVER ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- DATABASE (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/socialpulse

# ---- REDIS (optional — app works without it) ----
REDIS_URL=redis://localhost:6379

# ---- JWT AUTH ----
# Generate: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# ============================================================
# AI PROVIDERS — Add keys for the AIs you want to use
# At least ONE is required. All three = full Compare Mode
# ============================================================

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini (Google) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# ---- RATE LIMITING ----
AI_RATE_LIMIT_PER_HOUR=50
API_RATE_LIMIT=100
