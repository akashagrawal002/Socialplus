# ============================================
# SocialPulse AI — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- SERVER ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- DATABASE (PostgreSQL) ----
# Local: postgresql://postgres:password@localhost:5432/socialpulse
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Railway: (auto-provided)
DATABASE_URL=postgresql://postgres:password@localhost:5432/socialpulse

# ---- REDIS (Sessions & Cache) ----
# Local: redis://localhost:6379
# Upstash free tier: rediss://:[password]@[host]:6380
REDIS_URL=redis://localhost:6379

# ---- JWT AUTH ----
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# ---- ANTHROPIC AI ----
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- RATE LIMITING ----
# Max AI requests per user per hour
AI_RATE_LIMIT_PER_HOUR=50
# Max API requests per IP per 15 minutes
API_RATE_LIMIT=100
